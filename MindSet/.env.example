# Copiar como .env y configurar la contraseña local de PostgreSQL.
POSTGRES_PASSWORD=CAMBIAR_POR_CLAVE_LOCAL

# Clave aleatoria compartida por los cuatro servicios, Base64 de al menos 32 bytes.
JWT_SECRET=

# Clave distinta para contratos internos de Usuarios, Profesionales y Citas (mínimo 32 caracteres).
# Vacía: las operaciones internas rechazan todas las peticiones.
INTERNAL_API_KEY=
PROFESIONALES_URL=http://localhost:8083
USUARIOS_URL=http://localhost:8081

# Adaptador REST síncrono provisional. No es procesamiento asíncrono.
PROCESAMIENTO_LOCAL_HABILITADO=false
